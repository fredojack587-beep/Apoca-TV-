
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Apoca TV</title>
<style>
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #080b20;
  color: white;
  min-height: 100vh;
  padding: 24px;
}
header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 35px;
}
.logo {
  background: #12a89d;
  border-radius: 12px;
  padding: 15px;
  font-size: 27px;
}
h1 { font-size: 28px; margin: 0 0 7px; }
header p { color: #b7bfd8; margin: 0; }
.menu {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}
.card {
  min-height: 220px;
  border: 3px solid transparent;
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 20px;
  cursor: pointer;
  color: white;
  font-size: 23px;
  font-weight: bold;
  transition: transform .15s;
}
.card:focus, .card:hover {
  outline: 3px solid white;
  transform: scale(1.03);
}
.card span { font-size: 55px; }
.live { background: #187bce; }
.movies { background: #e65c45; }
.series { background: #573b78; }
#message {
  margin-top: 30px;
  color: #d4d9e8;
  font-size: 18px;
}
@media(max-width:600px) {
  body { padding: 15px; }
  .menu { grid-template-columns: 1fr; }
  .card { min-height: 130px; }
}
</style>
</head>
<body>
<header>
  <div class="logo">📺</div>
  <div>
    <h1>APOCA TV</h1>
    <p>Votre télévision, votre univers</p>
  </div>
</header>

<main class="menu">
  <button class="card live" onclick="ouvrir('LIVE TV')">
    <span>📡</span> LIVE TV
  </button>
  <button class="card movies" onclick="ouvrir('MOVIES')">
    <span>🎬</span> MOVIES
  </button>
  <button class="card series" onclick="ouvrir('SERIES')">
    <span>📽️</span> SERIES
  </button>
</main>

<div id="message">Bienvenue sur Apoca TV !</div>

<script>
function ouvrir(section) {
  document.getElementById("message").textContent =
    section + " : les contenus seront ajoutés prochainement.";
}
</script>
</body>
</html>
